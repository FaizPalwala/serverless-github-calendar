{
  "name": "serverless-github-calendar",
  "version": "1.0.0",
  "description": "Serverless GitHub Contribution Heatmap for React",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./rsc": {
      "import": "./dist/rsc.mjs",
      "require": "./dist/rsc.js"
    },
    "./style.css": "./style.css",
    "./themes/*": "./themes/*"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.5",
    "vite": "^8.2.2"
  }
}
