{
  "name": "serverless-github-calendar",
  "version": "2.0.0",
  "description": "Serverless GitHub Contribution Heatmap for React",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./rsc": {
      "import": "./dist/rsc.mjs",
      "require": "./dist/rsc.js"
    },
    "./style.css": "./style.css",
    "./themes/*": "./themes/*"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.5",
    "vite": "^8.2.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FaizPalwala/serverless-github-calendar.git"
  },
  "homepage": "https://github.com/FaizPalwala/serverless-github-calendar#readme",
  "bugs": {
    "url": "https://github.com/FaizPalwala/serverless-github-calendar/issues"
  },
  "keywords": [
    "github",
    "calendar",
    "heatmap",
    "contributions",
    "react",
    "nextjs",
    "rsc",
    "serverless"
  ],
  "author": "FaizPalwala",
  "license": "MIT",
  "files": [
    "dist",
    "style.css",
    "themes"
  ]
}